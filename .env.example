# ============================================================
# ZapLink — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env no Git.
# ============================================================

# ─── Motor de Automação (server.js) ────────────────────────
# Token de autenticação entre o Next.js e o servidor Node.
# Use: openssl rand -hex 32
WA_AUTH_TOKEN=

# URL base do dashboard SaaS (usada no CORS e em links de redirect)
SAAS_URL=https://zaplink.casalbrokersistema.online

# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Mercado Pago ───────────────────────────────────────────
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=

# Secret para verificar assinatura HMAC dos webhooks do MP
# Configure em: MP Dashboard → Webhooks → Assinatura Secreta
MP_WEBHOOK_SECRET=

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://zaplink.casalbrokersistema.online
NEXT_PUBLIC_WA_SERVER_URL=http://localhost:3001

# ─── OpenAI (opcional — gerenciado pelo painel de IA) ───────
# As chaves dos usuários são gerenciadas pela API /api/users/ai-settings
# e devem ser armazenadas criptografadas no banco, NÃO em arquivo local.

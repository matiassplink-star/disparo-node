{
  "name": "zaplink-desktop",
  "version": "1.0.1",
  "description": "",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "chrome-launcher": "^1.2.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-machine-id": "^1.1.12",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7",
    "ws": "^8.20.0"
  },
  "type": "module",
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.zaplink.desktop",
    "productName": "ZAPLINK por Marco DMatias",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "dashboard.html",
      "login.html",
      "favicon.png",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "favicon.png",
      "cscLink": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ZapLink",
      "include": "installer.nsh"
    },
    "compression": "store",
    "forceCodeSigning": false,
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "matiassplink-star",
        "repo": "zaplink-releases"
      }
    ]
  }
}
